# ---- Server ----
PORT=3000

# ---- Lark / Feishu App credentials ----
# Tao app tai https://open.larksuite.com/app (quoc te) hoac https://open.feishu.cn/app (Trung Quoc)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LARK_DOMAIN=lark  -> dung Lark quoc te (open.larksuite.com)
# LARK_DOMAIN=feishu -> dung Feishu Trung Quoc (open.feishu.cn)
LARK_DOMAIN=lark

# Event Subscription: Encrypt Key + Verification Token (lay trong "Event Subscriptions" cua app)
LARK_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=

# Ten workspace de dung link doc (vd: your-team.larksuite.com). De trong neu khong can link.
LARK_WORKSPACE_DOMAIN=

# ---- Gemini (Google AI) ----
# Lay tai https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# ---- Email (SMTP gui / IMAP tim kiem) ----
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USER=your-agent@yourdomain.com
EMAIL_PASSWORD=app-password-here

# ---- Goi API/he thong noi bo cua EIV ----
# Danh sach domain duoc phep goi (phan tach boi dau phay), vd: https://api.eiv.edu.vn,https://crm.eiv.edu.vn
INTERNAL_API_ALLOWED_BASE_URLS=
# Token/API key dung chung khi goi cac API noi bo (gui qua header Authorization: Bearer <token>)
INTERNAL_API_TOKEN=

# Lark Base (Bitable) mac dinh de agent thao tac neu nguoi dung khong chi ro (tuy chon)
DEFAULT_BITABLE_APP_TOKEN=
DEFAULT_BITABLE_TABLE_ID=

# Lark Calendar mac dinh (tuy chon, mac dinh la "primary" cua bot)
DEFAULT_CALENDAR_ID=primary
